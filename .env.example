# Document Conversion Studio Python Backend
# When hosted (Render, Railway, Fly.io, or VPS), Next.js forwards conversion requests
# to this Python service for 100% exact layout, font, and multilingual fidelity.

# URL of the hosted Python FastAPI server (without trailing slash)
CONVERSION_API_URL=https://your-python-api.onrender.com

# Optional security API key (must match CONVERSION_API_KEY on the Python server)
CONVERSION_API_KEY=your_secret_api_key
